POSTGRES_PASSWORD=replace-with-strong-local-secret
DATABASE_URL=postgresql://civic:replace-with-strong-local-secret@127.0.0.1:5432/civic_lens
API_PORT=8080
VITE_API_BASE_URL=http://localhost:8080
DEMO_MODE=true
# P3 runtime identity: login role mcl_api (member of mcl_app, read-only). Put the real value only in the ignored .env.local, then run: cargo run -p mcl-infrastructure --bin mcl-seed -- provision-api-role
APP_DATABASE_URL=postgresql://mcl_api:replace-with-app-local-secret@127.0.0.1:5432/civic_lens
# Optional API bind/CORS (defaults: 127.0.0.1, 8080, http://localhost:5173 only). A non-loopback host also needs API_ALLOW_NON_LOOPBACK=true.
# API_HOST=127.0.0.1
# API_CORS_EXTRA_ORIGIN=http://localhost:4173
# P5 command identity: login role mcl_api_write (NOINHERIT, may SET ROLE mcl_command only; insert-only grants). Put the real value only in the ignored .env.local, then run: cargo run -p mcl-infrastructure --bin mcl-seed -- provision-command-roles
APP_WRITE_DATABASE_URL=postgresql://mcl_api_write:replace-with-write-local-secret@127.0.0.1:5432/civic_lens
