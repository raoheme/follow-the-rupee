{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "contract",
  "required": [
    "id",
    "recordNature",
    "sourceTier",
    "recordVersion",
    "updatedAt",
    "tenderId",
    "budgetId",
    "vendorId",
    "displayTitle",
    "contractStatus",
    "awardedOn",
    "valuePaise"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "recordNature": {
      "const": "SYNTHETIC_DEMONSTRATION"
    },
    "sourceTier": {
      "enum": [
        "SYNTHETIC_DEMO",
        "COMMUNITY_REFERENCE",
        "OFFICIAL_SOURCE_PENDING"
      ]
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenderId": {
      "type": "string",
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "budgetId": {
      "type": "string",
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "vendorId": {
      "type": "string",
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "displayTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contractStatus": {
      "enum": [
        "AWARDED",
        "COMPLETED_IN_DLP"
      ]
    },
    "awardedOn": {
      "type": "string",
      "format": "date"
    },
    "valuePaise": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
