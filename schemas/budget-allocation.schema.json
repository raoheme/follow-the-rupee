{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "budget-allocation",
  "required": [
    "id",
    "recordNature",
    "sourceTier",
    "recordVersion",
    "updatedAt",
    "displayTitle",
    "budgetBookName",
    "budgetHead",
    "amountPaise",
    "financialYear",
    "departmentId",
    "traceabilityStatus",
    "lastProvenLink",
    "missingNextLink",
    "traceabilityExplanation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "recordNature": {
      "const": "SYNTHETIC_DEMONSTRATION"
    },
    "sourceTier": {
      "enum": [
        "SYNTHETIC_DEMO",
        "COMMUNITY_REFERENCE",
        "OFFICIAL_SOURCE_PENDING"
      ]
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "displayTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "budgetBookName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "budgetHead": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "amountPaise": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "financialYear": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "departmentId": {
      "type": "string",
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "traceabilityStatus": {
      "enum": [
        "LINKED_TO_STREET",
        "GAP_BEFORE_STREET_GEOMETRY"
      ]
    },
    "lastProvenLink": {
      "enum": [
        "BUDGET",
        "TENDER",
        "CONTRACT",
        "WORK_ORDER",
        "ASSET_GEOMETRY"
      ]
    },
    "missingNextLink": {
      "enum": [
        "TENDER",
        "CONTRACT",
        "WORK_ORDER",
        "STREET_LEVEL_GEOMETRY",
        null
      ]
    },
    "traceabilityExplanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "traceabilityStatus": {
            "const": "GAP_BEFORE_STREET_GEOMETRY"
          }
        },
        "required": [
          "traceabilityStatus"
        ]
      },
      "then": {
        "properties": {
          "missingNextLink": {
            "type": "string"
          },
          "lastProvenLink": {
            "enum": [
              "BUDGET",
              "TENDER",
              "CONTRACT",
              "WORK_ORDER"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "missingNextLink": {
            "type": "null"
          },
          "lastProvenLink": {
            "const": "ASSET_GEOMETRY"
          }
        }
      }
    }
  ]
}
