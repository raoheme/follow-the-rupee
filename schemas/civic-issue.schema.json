{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "civic-issue",
  "required": [
    "id",
    "recordNature",
    "sourceTier",
    "recordVersion",
    "updatedAt",
    "title",
    "publicDescription",
    "category",
    "status",
    "publicStatusExplanation",
    "reportedAt",
    "streetName",
    "nearbyLandmark",
    "geometry",
    "assetId",
    "workOrderId",
    "wardCandidateId",
    "responsibleDepartmentId",
    "responsiblePostTitle",
    "escalationPostTitle",
    "journeys"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "recordNature": {
      "const": "SYNTHETIC_DEMONSTRATION"
    },
    "sourceTier": {
      "enum": [
        "SYNTHETIC_DEMO",
        "COMMUNITY_REFERENCE",
        "OFFICIAL_SOURCE_PENDING"
      ]
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "publicDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "category": {
      "enum": [
        "POTHOLE",
        "DRAIN_BLOCKAGE",
        "WATERLOGGING",
        "FACILITY_REPAIR"
      ]
    },
    "status": {
      "enum": [
        "DRAFT_LOCAL",
        "SUBMITTED_UNVERIFIED",
        "TRIAGED_ASSIGNED",
        "IN_PROGRESS",
        "CLOSURE_CLAIMED_PENDING_VERIFICATION",
        "VERIFIED_COMPLETE",
        "DISPUTED_REOPENED"
      ]
    },
    "publicStatusExplanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "reportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "streetName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nearbyLandmark": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 72.77,
                  "maximum": 72.99
                },
                {
                  "type": "number",
                  "minimum": 18.89,
                  "maximum": 19.275
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 72.77,
                    "maximum": 72.99
                  },
                  {
                    "type": "number",
                    "minimum": 18.89,
                    "maximum": 19.275
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 72.77,
                      "maximum": 72.99
                    },
                    {
                      "type": "number",
                      "minimum": 18.89,
                      "maximum": 19.275
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        }
      ]
    },
    "assetId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "workOrderId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "wardCandidateId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "responsibleDepartmentId": {
      "type": "string",
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "responsiblePostTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "escalationPostTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "parentRecurrenceId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SYN-DEMO-[A-Z0-9][A-Z0-9-]*$"
    },
    "journeys": {
      "type": "array",
      "items": {
        "enum": [
          "J1",
          "J2",
          "J3",
          "J4",
          "J5",
          "J6",
          "PREVIEW"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
